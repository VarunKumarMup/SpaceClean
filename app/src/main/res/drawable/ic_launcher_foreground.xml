        android:strokeColor="#35D08E"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />

    <!-- ── Swept-away files (doc / photo / folder) ────────────────────────── -->
    <!-- Blue document with folded corner + text lines -->
    <path
        android:pathData="M26,29 h7.5 l3.5,3.5 v10 a2,2 0 0 1 -2,2 h-9 a2,2 0 0 1 -2,-2 v-11.5 a2,2 0 0 1 2,-2 z"
        android:fillColor="#3B82F6" />
    <path android:pathData="M33.5,29 l3.5,3.5 h-3.5 z" android:fillColor="#BFDBFE" />
    <path
        android:pathData="M27.5,37.5 h8 M27.5,40.5 h6"
        android:strokeColor="#EFF6FF"
        android:strokeWidth="1.4"
        android:strokeLineCap="round" />

    <!-- Green photo tile with sun + mountain -->
    <path
        android:pathData="M22,52 h12 a2.2,2.2 0 0 1 2.2,2.2 v8.6 a2.2,2.2 0 0 1 -2.2,2.2 h-12 a2.2,2.2 0 0 1 -2.2,-2.2 v-8.6 a2.2,2.2 0 0 1 2.2,-2.2 z"
