        android:fillColor="#ECFDF5" />
    <path
        android:pathData="M21.5,63.5 l4.4,-4.6 l3,3 l2.6,-2.2 l3.8,3.8 z"
        android:fillColor="#A7F3D0" />

    <!-- Orange folder -->
    <path
        android:pathData="M27,70 h4.6 l1.8,2 h6.4 a2,2 0 0 1 2,2 v6.5 a2,2 0 0 1 -2,2 h-12.8 a2,2 0 0 1 -2,-2 v-8.5 a2,2 0 0 1 2,-2 z"
        android:fillColor="#F59E0B" />
    <path
        android:pathData="M25,75 h16.8 v5.5 a2,2 0 0 1 -2,2 h-12.8 a2,2 0 0 1 -2,-2 z"
        android:fillColor="#FBBF24" />

    <!-- ── Sparkles ───────────────────────────────────────────────────────── -->
    <path
        android:pathData="M45,32 l1.2,3 l3,1.2 l-3,1.2 l-1.2,3 l-1.2,-3 l-3,-1.2 l3,-1.2 z"
        android:fillColor="#EAF6FF" />
    <path
        android:pathData="M40,45 l0.9,2.1 l2.1,0.9 l-2.1,0.9 l-0.9,2.1 l-0.9,-2.1 l-2.1,-0.9 l2.1,-0.9 z"
        android:fillColor="#BFE3FF" />

    <!-- Motion swoosh under the sweep -->
    <path
        android:pathData="M18,68 Q30,76 42,78"
        android:strokeColor="#59FFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M22,78 Q31,83 40,84"
        android:strokeColor="#38FFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />

    <!-- ── Broom, tilted like the reference ───────────────────────────────── -->
    <group
        android:rotation="30"
        android:pivotX="56"
        android:pivotY="56">

        <!-- Handle -->
        <path
            android:pathData="M56,23 L56,44"
            android:strokeWidth="9"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="56" android:startY="23"
                    android:endX="56" android:endY="44">
                    <item android:offset="0" android:color="#FF3D8BF5" />
                    <item android:offset="1" android:color="#FF1D64D8" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Handle hole -->
        <path
            android:pathData="M56,26.6 m-1.7,0 a1.7,1.7 0 1 0 3.4,0 a1.7,1.7 0 1 0 -3.4,0"
            android:fillColor="#0F3E9E" />

        <!-- White ferrule / head -->
        <path
            android:pathData="M47.5,42 h17 a3.2,3.2 0 0 1 3.2,3.4 l-0.9,12.6 h-21.6 l-0.9,-12.6 a3.2,3.2 0 0 1 3.2,-3.4 z"
            android:fillColor="#FFFFFF" />
        <!-- Head shading edge -->
        <path
            android:pathData="M45.3,55 h21.4 l0.2,3 h-21.8 z"
            android:fillColor="#E4EDFB" />

        <!-- Lightning bolt on the head -->
        <path
            android:pathData="M58.6,44.5 L52.4,52.2 h3.4 L54.2,58 L60.6,50.4 h-3.4 z"
            android:fillColor="#2D7BF0" />

        <!-- Bristles — white strands fanning down -->
        <path
            android:pathData="M46.5,59.5 C44.5,67 41.5,73 37.5,78"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="6"
            android:strokeLineCap="round" />
        <path
            android:pathData="M52.5,60 C51.5,68.5 50,75 48,80.5"
            android:strokeColor="#F3F7FE"
            android:strokeWidth="6"
            android:strokeLineCap="round" />
        <path
            android:pathData="M58.8,60 C59.3,68.5 60.2,75 61.8,80.5"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="6"
            android:strokeLineCap="round" />
        <path
            android:pathData="M64.8,59.5 C67,67 69.8,72.5 73.4,77"
            android:strokeColor="#E9F1FC"
            android:strokeWidth="6"
            android:strokeLineCap="round" />
    </group>
</vector>
